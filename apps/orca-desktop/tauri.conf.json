{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ORCA RadioAIR",
  "version": "0.7.2",
  "identifier": "cz.orca.radioair",
  "build": {
    "frontendDist": "../../ui-dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "nsis",
      "msi"
    ],
    "category": "Music",
    "shortDescription": "Odbavovací systém pro rádio",
    "longDescription": "ORCA RadioAIR – automatické vysílání, knihovna, clocky, streamování do Icecastu.",
    "copyright": "© 2026 ORCA RadioAIR",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/": "resources/",
      "../../ui-dist/": "ui/"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU2OTI3Q0M2NDdFMDk2ODIKUldTQ2x1Qkh4bnlTNXFZa3MxMWVhc2puS0hDQUxwYmNpbkUxSW5LR1hlZ2FNM2Nmam1HaGVlRi8K",
      "endpoints": [
        "https://github.com/adminphmedia/ORCA-RadioAIR/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
