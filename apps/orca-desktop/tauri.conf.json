{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ORCA RadioAIR",
  "version": "0.2.0",
  "identifier": "cz.orca.radioair",
  "build": { "frontendDist": "../../ui-dist" },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis", "msi"],
    "category": "Music",
    "shortDescription": "Odbavovací systém pro rádio",
    "longDescription": "ORCA RadioAIR – automatické vysílání, knihovna, clocky, streamování do Icecastu.",
    "copyright": "© 2026 ORCA RadioAIR",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "resources/": "resources/", "../../ui-dist/": "ui/" },
    "macOS": { "minimumSystemVersion": "11.0", "signingIdentity": "-" },
    "windows": { "nsis": { "installMode": "perMachine" } }
  }
}
